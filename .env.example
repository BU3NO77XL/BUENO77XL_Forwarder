# ============================================================
# Credenciais da API do Telegram
# Obtenha as suas GRATUITAMENTE em: https://my.telegram.org/apps
# ============================================================
# 1. Faca login com seu numero de telefone
# 2. Va em "API development tools"
# 3. Copie os valores "App api_id" e "App api_hash"
# 4. Preencha as variaveis abaixo (sem espacos, sem aspas)
#
# Exemplo:
#   API_ID=1234567
#   API_HASH=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
# ============================================================

API_ID=
API_HASH=

# ============================================================
# Configuracao do daemon (daemon.py) para rodar na VPS
# ============================================================
# Numero da conta que sera usada (deve existir em account/ e data/)
# USE NUMEROS DE EXEMPLO AQUI - nunca coloque numeros reais neste arquivo modelo
PHONE=+5511999999999

# Canal de ORIGEM (de onde as mensagens sao copiadas)
# Aceita @username, t.me/+token (invite) ou id numerico -100xxxxxxxxxx
FROM_CHAT=

# Canal de DESTINO (para onde as mensagens serao enviadas)
TO_CHAT=

# Intervalo entre verificacoes de novas mensagens, em segundos
CHECK_INTERVAL=120